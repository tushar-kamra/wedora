# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/wedora

# Authentication & Security
SESSION_SECRET=replace-with-at-least-32-bytes-of-random-entropy-secret-key
CRON_SECRET=replace-with-secure-cron-secret

# Email (Resend)
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM="Wedora <no-reply@wedora.com>"

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_secret_access_key
R2_BUCKET_NAME=make-my-marriage-dev

# Vendor Discovery (Google Places)
GOOGLE_PLACES_API_KEY=placeholder_google_places_key

